{
  "name": "macOS | Weather",
  "version": "1.0.0",
  "author": "lightleo7",
  "description": "Minimal macOS-style weather, based on open-meteo",

  "default_width": 340,
  "default_height": 220,

  "interactive": false,

  "settings": [
      {
        "key": "latitude",
        "label": "Latitude",
        "type": "number",
        "default": 57.6265,
        "min": -90,
        "max": 90,
        "step": 0.0001
      },
      {
        "key": "longitude",
        "label": "Longitude",
        "type": "number",
        "default": 38.8938,
        "min": -90,
        "max": 90,
        "step": 0.0001
      }
    ]
}